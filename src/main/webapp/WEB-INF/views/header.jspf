<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Plain Goods</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="${ctx}/style.css">
</head>
<body>
<header class="header">
  <div class="container nav">
    <a class="brand" href="${ctx}/"><span class="logo"></span>Plain Goods</a>
    <nav>
      <c:choose>
        <c:when test="${not empty sessionScope.admin}">
          <a href="${ctx}/admin">Dashboard</a>
          <a href="${ctx}/logout">Log out</a>
        </c:when>
        <c:when test="${not empty sessionScope.user}">
          <a href="${ctx}/orders">My orders</a>
          <span class="who"><c:out value="${sessionScope.user.name}"/></span>
          <a href="${ctx}/logout">Log out</a>
        </c:when>
        <c:otherwise>
          <a href="${ctx}/login">Log in</a>
          <a class="btn btn-dark" href="${ctx}/register">Sign up</a>
        </c:otherwise>
      </c:choose>
    </nav>
  </div>
</header>
<main class="container">
